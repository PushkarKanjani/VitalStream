# VitalStream — Production Environment Configuration
# Stack: Apache Kafka 3.6 · Apache Flink 1.18 · Apache Cassandra 4.1 · MongoDB 7.0 · FastAPI · Nginx

# ── General Production ────────────────────────────────────────────────────────
NODE_ENV=production
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:5173
SECRET_KEY=vs_clinical_gandhinagar_sec_key_prod_2024_hmac_9812

# ── MongoDB 7.0 ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb://vsadmin:vspass2024@mongodb:27017/vitalstream?authSource=admin
MONGO_DB=vitalstream

# ── Cassandra 4.1 (TWCS Time-Series Lake) ────────────────────────────────────
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=vitalstream

# ── Kafka 3.6 (6 Partition Telemetry Bus) ─────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_VITALS=vitals.raw
KAFKA_TOPIC_CASES=cases.events
KAFKA_TOPIC_ALERTS_RAISED=alerts.raised
KAFKA_TOPIC_ALERTS_ACK=alerts.acknowledged
KAFKA_GROUP_ID=vitalstream-consumer

# ── Apache Flink 1.18 ─────────────────────────────────────────────────────────
FLINK_URL=http://jobmanager:8081

# ── FastAPI Backend ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Hospital Metadata ─────────────────────────────────────────────────────────
HOSPITAL_NAME="Apollo Hospitals, Gandhinagar"
HOSPITAL_UNIT="Perioperative Surgical Command Center · OR Suite 1-6"
TIMEZONE="Asia/Kolkata"
