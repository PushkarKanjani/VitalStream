# VitalStream — Environment Variables
# Copy this to .env and fill in values

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://vsadmin:vspass2024@localhost:27017/vitalstream?authSource=admin
MONGO_DB=vitalstream

# ── Cassandra ─────────────────────────────────────────────────────────────────
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=vitalstream

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9093
KAFKA_TOPIC_VITALS=vitals.raw
KAFKA_TOPIC_CASES=cases.events
KAFKA_TOPIC_ALERTS_RAISED=alerts.raised
KAFKA_TOPIC_ALERTS_ACK=alerts.acknowledged
KAFKA_GROUP_ID=vitalstream-consumer

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5000
SECRET_KEY=vs_super_secret_key_change_in_prod_2024

# ── VitalDB ───────────────────────────────────────────────────────────────────
# Leave empty — vitaldb Python package downloads directly via API
VITALDB_CASE_LIMIT=50    # number of cases to stream (6388 total available)
